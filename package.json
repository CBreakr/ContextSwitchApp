{
  "name": "context-switch",
  "version": "1.0.0",
  "description": "ContextSwitch — a canvas-based context management app",
  "author": "robnot",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.contextswitch.app",
    "productName": "ContextSwitch",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
