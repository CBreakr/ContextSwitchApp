{
  "manifest_version": 3,
  "name": "ContextSwitch",
  "version": "1.0.0",
  "description": "Add the current web page to a ContextSwitch context with a screenshot.",

  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Add to ContextSwitch",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
